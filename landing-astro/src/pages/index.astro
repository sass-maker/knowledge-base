---
import Base from '@saas-maker/templates/Base.astro';
import { WorkbenchPage } from '@saas-maker/templates/workbench-page';
import { baseProps } from '@saas-maker/templates/page';
import { workbenchContent } from '@saas-maker/templates/schema';
import { studioFromProjects, studioProjectsFeed } from '@saas-maker/ui/blocks/footer';
import json from '../content/home.json';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';

const content = workbenchContent.parse(json);
const projects = await fetch(studioProjectsFeed, { signal: AbortSignal.timeout(1000) })
  .then((response) => (response.ok ? response.json() : []))
  .catch(() => []);
if (content.footer) content.footer.studio = studioFromProjects(projects, { current: 'knowledge-base' });
const widths = [360, 720, 1152, 1600];
const images = widths.map((width) => ({ src: `/images/evidence-console-${width}.webp` }));
// WindowFrame does not forward responsive-image props. Enhance its static HTML
// at build time, preserving the shared frame and its intrinsic dimensions.
const pageHtml = renderToStaticMarkup(createElement(WorkbenchPage, { content }))
  .replace(/<img\b[^>]*src="\/images\/evidence-console\.webp"[^>]*>/, (image) =>
    image
      .replace(
        'src="/images/evidence-console.webp"',
        `src="${images[1].src}" srcset="${images.map((image, index) => `${image.src} ${widths[index]}w`).join(', ')}" sizes="(min-width: 1216px) 1024px, (min-width: 1024px) calc(95vw - 130px), (min-width: 640px) calc(95vw - 98px), calc(95vw - 50px)"`,
      )
      .replace('loading="eager"', 'loading="lazy"')
      .replace(' fetchPriority="high"', '')
      .replace(' fetchpriority="high"', ''),
  )
  .replace(/<link\b[^>]*rel="preload"[^>]*href="\/images\/evidence-console\.webp"[^>]*\/>/, '');
const props = baseProps(content);
---

<!-- Base couples its preload to the display face. Select the LCP body font for
     delivery, then preserve Ink's existing heading and accent tokens. -->
<Base {...props} fonts={{ display: 'geist' }} tokens={{ ...props.tokens, '--font-display': '"Figtree Variable", ui-sans-serif, system-ui, sans-serif', '--display-weight': '750', '--font-accent': '"Instrument Serif", Georgia, serif' }}>
  <Fragment slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/markdown" href={`${content.url}/index.md`} />
    <link rel="ai-catalog" type="application/json" href={`${content.url}/.well-known/ai-catalog.json`} />
