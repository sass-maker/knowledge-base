---
import Layout from '../layouts/Layout.astro';
import { publicSurfaces } from '../config/public-surfaces';

const home = publicSurfaces[0];
---

<!--
THESIS: Private search earns trust by keeping the evidence visibly attached; refuse the generic feature-card landing.
OWN-WORLD: Near-black field, paper-white type, one saturated teal action color, compact evidence-console details.
STORY: Understand the fleet role, see how cited retrieval behaves, inspect operating proof, then read the integration contract.
FIRST VIEWPORT: Wordmark and quiet source link above a large two-line promise, exact audience and boundary copy, and one primary action.
FORM: Preserve the recovered evidence-console landing structure; no direction seed because the incumbent live page is authoritative.
-->
<Layout title={home.title} description={home.description}>
  <header class="shell nav">
    <a class="brand" href="/">
      <span aria-hidden="true">KB</span>
      Knowledge Base
    </a>
    <nav aria-label="Primary">
      <a href="#evidence">Evidence</a>
      <a href="#proof">Proof</a>
      <a class="nav-action" href="https://github.com/sass-maker/knowledge-base/blob/main/docs/product/agent-tool-contract.md">Read the integration contract</a>
    </nav>
  </header>

  <main class="shell">
    <section class="hero" aria-labelledby="hero-title">
      <p class="signal"><span></span> Fleet retrieval layer · cited by default</p>
      <h1 id="hero-title">Private sources in.<br />Cited answers out.</h1>
      <p class="lede">
        Knowledge Base gives Fleet products and agents grounded answers from approved,
        specialized corpora. It searches by exact terms or meaning, ranks the evidence,
        and keeps every useful answer tied to a file, page, and excerpt.
      </p>

      <div class="actions">
        <a class="button" href="https://github.com/sass-maker/knowledge-base/blob/main/docs/product/agent-tool-contract.md">
          Read the integration contract <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="/index.md">Read the public product brief</a>
      </div>
      <p class="access-note">
        Internal infrastructure, not a public document-chat product. The operator workspace
        is Access-protected, and retrieval is limited to approved Fleet consumers.
      </p>
    </section>

    <section id="evidence" class="evidence" aria-labelledby="evidence-title">
      <div class="section-heading">
        <p>Illustrative interface</p>
        <h2 id="evidence-title">The answer stays attached to its proof.</h2>
      </div>

      <div class="evidence-console">
        <div class="query">
          <span aria-hidden="true">⌕</span>
          What changed in the renewal terms?
        </div>
        <div class="answer">
          <p>
            The renewal window moved from 30 days to 45 days, while the notice
            requirement stayed unchanged.
          </p>
          <div class="citations" aria-label="Illustrative citations">
            <details open>
              <summary>Agreement.pdf <span>page 12</span></summary>
              <p>
                “The agreement renews for an additional 45-day period unless
                notice is received before the existing notice deadline.”
              </p>
            </details>
            <details>
              <summary>Amendment.docx <span>section 4</span></summary>
              <p>
                “The notice requirement remains unchanged; only the renewal
                period described in the agreement is amended.”
              </p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="process" aria-labelledby="process-title">
      <div class="section-heading">
        <p>How it works</p>
        <h2 id="process-title">One question, three inspectable stages.</h2>
      </div>
      <ol>
        <li>
          <strong>Scope the corpus</strong>
          <span>A tenant credential limits the query to one approved project and domain.</span>
        </li>
        <li>
          <strong>Search and rank</strong>
          <span>Lexical and semantic retrieval find the most relevant source passages.</span>
        </li>
        <li>
          <strong>Return the trail</strong>
          <span>The answer arrives with ranked citations, provenance, confidence, and trace data.</span>
        </li>
      </ol>
    </section>

    <section id="proof" class="proof" aria-labelledby="proof-title">
      <div class="section-heading">
        <p>Operating proof</p>
        <h2 id="proof-title">It already serves Fleet products. That is the point.</h2>
      </div>
      <dl class="proof-ledger">
        <div>
          <dt>Current consumers</dt>
          <dd>Karte · Research Papers · Starboard</dd>
        </div>
        <div>
          <dt>Evidence invariant</dt>
          <dd><code>file_id · page · excerpt</code></dd>
        </div>
        <div>
          <dt>Active runtime</dt>
          <dd>One Cloudflare Worker</dd>
        </div>
        <div>
          <dt>Maintenance rule</dt>
          <dd>Change it for a consumer need or retrieval failure.</dd>
        </div>
      </dl>
    </section>

    <aside class="boundary">
      <strong>The public boundary stays small.</strong>
      This site explains the system. It does not publish indexed material,
      search history, operator settings, authenticated routes, or retrieval access.
    </aside>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div>
        <p>For a concrete Fleet need</p>
        <h2 id="final-cta-title">Start with the cited query contract, not a generic chat box.</h2>
        <a class="operator-link" href="https://search.sassmaker.com">Open the operator workspace · Fleet Access required</a>
      </div>
      <a class="button" href="https://github.com/sass-maker/knowledge-base/blob/main/docs/product/agent-integration-examples.md">
        Review integration examples <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <footer class="shell product-footer">
    <div>
      <span class="footer-label">Knowledge Base</span>
      <strong>Private, cited retrieval for Fleet products and agents.</strong>
    </div>
    <p>
      Maintained internal infrastructure. There is no public signup, checkout,
      or permanent pricing promise.
    </p>
    <p>
      This public landing uses PostHog for a page-view event and Microsoft
      Clarity for session replay and heatmaps. The Access-protected operator
      workspace is a separate surface and does not load this landing layout.
    </p>
    <nav aria-label="Product links">
      <a href="/index.md">Public brief</a>
      <a href="https://github.com/sass-maker/knowledge-base/blob/main/docs/product/agent-tool-contract.md">Agent contract</a>
      <a
        href="https://github.com/sass-maker/knowledge-base"
        aria-label="GitHub repository"
        title="GitHub repository"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </nav>
  </footer>
</Layout>
