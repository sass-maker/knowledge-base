    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_76e3c4590fa1b94361359263df2b8e2637024757c84c795d056ecb7efe5d6cfb"
      data-project="app-cf422c0b-61cc-46b8-abc4-3fc280b0294c"
      data-identity="persistent"
      data-vitals
    ></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const events = {
          'https://github.com/sass-maker/knowledge-base/blob/main/docs/product/agent-tool-contract.md': 'integration.contract.opened',
          'https://github.com/sass-maker/knowledge-base/blob/main/docs/product/agent-integration-examples.md': 'integration.examples.opened',
          'https://search.sassmaker.com': 'operator.workspace.opened',
        };
        const evidence = document.querySelector('main figure');
        if (evidence) {
          evidence.id = 'evidence';
        }
        document.querySelectorAll('a[href]').forEach((link) => {
          const name = events[link.getAttribute('href')];
          if (name) link.setAttribute('data-app-health-event', name);
        });
      });
    </script>
    <script is:inline>
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('[data-app-health-event]');
      const eventName = link?.getAttribute('data-app-health-event');
      if (!eventName || !(link instanceof HTMLAnchorElement)) return;
      const tracker = window.appHealth;
      tracker?.track(eventName);

      // Keep the click event in the App Health batch before same-tab navigation.
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        link.target === '_blank' ||
        link.hasAttribute('download') ||
        !tracker
      )
        return;
      event.preventDefault();
      const destination = link.href;
      let timer;
      void Promise.race([
        tracker.flush(),
        new Promise((resolve) => {
          timer = window.setTimeout(resolve, 1200);
        }),
      ])
        .catch(() => undefined)
        .finally(() => {
          window.clearTimeout(timer);
          window.location.assign(destination);
        });
    }, true);
  </script>
  </Fragment>
  <Fragment set:html={pageHtml} />
</Base>

<style is:global>
  /* Paint the LCP text immediately; keep its final styling and position. */
  main > section:first-child .lede.hero-in { animation: none; }
</style>
