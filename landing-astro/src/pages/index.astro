---
import Layout from '../layouts/Layout.astro';
import { publicSurfaces } from '../config/public-surfaces';

const home = publicSurfaces[0];
---

<!--
THESIS: Private search earns trust by keeping the evidence visibly attached; refuse the generic feature-card landing.
OWN-WORLD: Near-black field, paper-white type, one saturated teal action color, compact evidence-console details.
STORY: Understand the private/public split, see how cited retrieval behaves, then enter the authenticated app.
FIRST VIEWPORT: Wordmark and quiet source link above a large two-line promise, boundary copy, and one primary action.
FORM: Preserve the recovered evidence-console landing structure; no direction seed because the incumbent live page is authoritative.
-->
<Layout title={home.title} description={home.description}>
  <header class="shell nav">
    <a class="brand" href="/">
      <span aria-hidden="true">KB</span>
      Knowledgebase
    </a>
    <nav aria-label="Primary">
      <a href="#evidence">Evidence</a>
      <a href="#how">How it works</a>
      <a class="nav-action" href="https://search.sassmaker.com">Sign in to private app</a>
    </nav>
  </header>

  <main class="shell">
    <section class="hero" aria-labelledby="hero-title">
      <p class="signal"><span></span> Private agent search · cited by default</p>
      <h1 id="hero-title">Any structure in.<br />Cited answers out.</h1>
      <p class="lede">
        Bring the material your team chooses. Knowledgebase retrieves by exact
        terms or meaning, then gives people and agents an answer they can trace
        back to source evidence.
      </p>

      <div class="actions">
        <a class="button" href="https://search.sassmaker.com">
          Sign in to the private app <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="/index.md">Read the public product brief</a>
      </div>
    </section>

    <section id="evidence" class="evidence" aria-labelledby="evidence-title">
      <div class="section-heading">
        <p>Illustrative interface</p>
        <h2 id="evidence-title">An answer stays attached to its proof.</h2>
      </div>

      <div class="evidence-console">
        <div class="query">
          <span aria-hidden="true">⌕</span>
          What changed in the renewal terms?
        </div>
        <div class="answer">
          <p>
            The renewal window moved from 30 days to 45 days, while the notice
            requirement stayed unchanged.
          </p>
          <div class="citations" aria-label="Illustrative citations">
            <details open>
              <summary>Agreement.pdf <span>page 12</span></summary>
              <p>
                “The agreement renews for an additional 45-day period unless
                notice is received before the existing notice deadline.”
              </p>
            </details>
            <details>
              <summary>Amendment.docx <span>section 4</span></summary>
              <p>
                “The notice requirement remains unchanged; only the renewal
                period described in the agreement is amended.”
              </p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="process" aria-labelledby="process-title">
      <div class="section-heading">
        <p>How it works</p>
        <h2 id="process-title">Private material in. Inspectable retrieval out.</h2>
      </div>
      <ol>
        <li>
          <strong>Index deliberately</strong>
          <span>Choose the documents and structured material that belong in a workspace.</span>
        </li>
        <li>
          <strong>Retrieve precisely</strong>
          <span>Search by exact terms or by meaning according to the question.</span>
        </li>
        <li>
          <strong>Verify the answer</strong>
          <span>Keep the file, page, and source excerpt with the result.</span>
        </li>
      </ol>
    </section>

    <aside class="boundary">
      <strong>The public boundary is intentionally small.</strong>
      This landing never publishes indexed material, search history, operator
      settings, authenticated application routes, or retrieval services.
    </aside>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div>
        <p>Access-protected workspace</p>
        <h2 id="final-cta-title">Ready to search private material with evidence attached?</h2>
      </div>
      <a class="button" href="https://search.sassmaker.com">
        Sign in to the private app <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <footer class="shell">
    <span>Knowledgebase is maintained by SaaS Maker.</span>
    <a href="https://github.com/sass-maker/knowledge-base">Source and roadmap</a>
  </footer>
</Layout>
