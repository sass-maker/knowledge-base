{
  "name": "knowledgebase-public-landing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Static public product landing for Knowledgebase.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check",
    "build": "astro build && node scripts/write-public-cache-generation.mjs",
    "agent:check": "node scripts/check-agent-surfaces.mjs && node scripts/check-readability-runtime.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run agent:check && pnpm run test:cache",
    "test:cache": "node scripts/format-cache.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "js-yaml": "4.3.2",
      "svgo": "4.1.0",
      "unifont>undici": "8.12.2",
      "postcss>nanoid": "3.3.18"
    },
    "patchedDependencies": {
      "@saas-maker/templates@0.1.14": "patches/saas-maker-templates-footer-retry-0.1.14.patch"
    }
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@saas-maker/motion": "github:sass-maker/ui-library#v0.1.14&path:/packages/motion",
    "@saas-maker/templates": "github:sass-maker/ui-library#v0.1.14&path:/packages/templates",
    "@saas-maker/ui": "github:sass-maker/ui-library#v0.1.14&path:/packages/ui",
    "@tailwindcss/vite": "4.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
