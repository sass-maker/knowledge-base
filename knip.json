{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"workspaces": {
		".": {
			"entry": ["blume.config.ts", "scripts/**/*.mjs"],
			"project": ["blume.config.ts", "scripts/**/*.mjs"],
			"ignoreDependencies": ["@biomejs/biome", "astro", "jscpd", "sharp"],
			"ignoreBinaries": ["build", "check", "typecheck"]
		},
		"app": {
			"entry": [
				"eslint.config.js",
				"functions/_middleware.ts",
				"functions/api/**/*.ts",
				"src/main.tsx",
				"vite.config.ts",
				"vitest.config.ts"
			],
			"project": ["functions/**/*.ts", "src/**/*.{ts,tsx}", "*.{js,ts}"],
			"ignoreDependencies": ["lightningcss", "tailwindcss", "wrangler"],
			"ignoreBinaries": ["wrangler"]
		},
		"cloudflare/worker": {
			"entry": [
				"src/index.ts",
				"src/service-bench.ts",
				"scripts/**/*.mjs",
				"vitest.config.ts"
			],
			"project": [
				"src/**/*.ts",
				"scripts/**/*.{mjs,ts}",
				"tests/**/*.ts",
				"vitest.config.ts"
			],
			"ignore": [
				"worker-configuration.d.ts",
				"scripts/backfill-saas-maker.mjs.d.ts",
				"scripts/migrate-raw-files.mjs.d.ts"
			],
			"ignoreDependencies": ["cloudflare", "wrangler"],
			"ignoreBinaries": ["wrangler"]
		},
		"landing-astro": {
			"entry": ["astro.config.mjs", "scripts/**/*.mjs"],
			"project": ["src/**/*.{astro,ts}", "scripts/**/*.mjs", "astro.config.mjs"]
		}
	}
}
